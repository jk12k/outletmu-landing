# Env untuk landing Outletmu (Vercel)
# Salin nilai sebenarnya ke Vercel → Project Settings → Environment Variables.

# Endpoint AI proxy (tunnel ke server lokal). Default sudah https://ai.outletmu.store/chat
OUTLETMU_AI_ENDPOINT=https://ai.outletmu.store/chat

# Shared secret antara landing dan AI proxy (WAJIB sama dengan OUTLETMU_AI_SECRET di proxy).
OUTLETMU_AI_SECRET=change-me-shared-secret
